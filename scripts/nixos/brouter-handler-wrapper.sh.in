#!/bin/sh
# brouter-handler: desktop-entry wrapper generated by the brouter flake.
# Plumbing only: it forwards URL arguments to the brouter binary that
# ships in the same package, with an absolute config path resolved from
# the invoking environment. No routing logic lives here or in Nix.
set -u

brouter="@brouter@"
config="${XDG_CONFIG_HOME:-${HOME:-}/.config}/brouter/config.toml"
state_dir="${XDG_STATE_HOME:-${HOME:-}/.local/state}/brouter"
log="$state_dir/handler.log"

mkdir -p "$state_dir" 2>/dev/null || log=/dev/null

# GUI launchers hide stderr and ignore exit status (see TASK-0007
# evidence), so diagnostics are appended to the state log and failures
# raise a bounded desktop notification with no URL in the text.
# The status is captured directly: inverting the pipeline would lose
# the child's exit status under POSIX $? semantics.
"$brouter" open --config "$config" "$@" >>"$log" 2>&1
status=$?
[ "$status" -eq 0 ] && exit 0
printf '%s handler failure (status %s)\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$status" >>"$log"
dbus-send --session --dest=org.freedesktop.Notifications --type=method_call \
	/org/freedesktop/Notifications org.freedesktop.Notifications.Notify \
	string:"brouter" uint32:0 string:"dialog-warning" \
	string:"brouter handler failed" string:"status $status — see handler.log" \
	int32:5000 >/dev/null 2>&1 || true
exit "$status"

