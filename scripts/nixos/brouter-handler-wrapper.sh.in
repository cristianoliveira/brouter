#!/bin/sh
# brouter-handler: desktop-entry wrapper generated by the brouter flake.
# Plumbing only: it forwards URL arguments to the brouter binary that
# ships in the same package, with an absolute config path resolved from
# the invoking environment. No routing logic lives here or in Nix.
set -u

# Every helper is pinned at package build time to an absolute store
# path: a GUI session may run the wrapper with an arbitrary or empty
# PATH, and diagnostics must never depend on it.
brouter="@brouter@"
mkdir_bin="@mkdir@"
date_bin="@date@"
dbus_send="@dbus_send@"
# Same config contract as the Go resolver: absolute $XDG_CONFIG_HOME
# wins; a relative or unset value falls back to $HOME/.config; missing
# HOME with no absolute XDG fails visibly before any launch.
config_root=""
case "${XDG_CONFIG_HOME:-}" in
	/*) config_root="$XDG_CONFIG_HOME" ;;
esac
if [ -z "$config_root" ]; then
	if [ -z "${HOME:-}" ]; then
		echo "brouter-handler: cannot determine the user config directory: set XDG_CONFIG_HOME to an absolute path, or set HOME" >&2
		"$dbus_send" --session --dest=org.freedesktop.Notifications --type=method_call \
			/org/freedesktop/Notifications org.freedesktop.Notifications.Notify \
			string:"brouter" uint32:0 string:"dialog-warning" \
			string:"brouter handler failed" string:"no config directory" \
			int32:5000 >/dev/null 2>&1 || true
		exit 2
	fi
	config_root="$HOME/.config"
fi
config="$config_root/brouter/config.toml"
state_dir="${XDG_STATE_HOME:-${HOME:-}/.local/state}/brouter"
log="$state_dir/handler.log"

"$mkdir_bin" -p "$state_dir" 2>/dev/null || log=/dev/null

# GUI launchers hide stderr and ignore exit status (see TASK-0007
# evidence), so diagnostics are appended to the state log and failures
# raise a bounded desktop notification with no URL in the text.
# The status is captured directly: inverting the pipeline would lose
# the child's exit status under POSIX $? semantics.
"$brouter" open --config "$config" "$@" >>"$log" 2>&1
status=$?
[ "$status" -eq 0 ] && exit 0
printf '%s handler failure (status %s)\n' "$("$date_bin" -u +%Y-%m-%dT%H:%M:%SZ)" "$status" >>"$log"
"$dbus_send" --session --dest=org.freedesktop.Notifications --type=method_call \
	/org/freedesktop/Notifications org.freedesktop.Notifications.Notify \
	string:"brouter" uint32:0 string:"dialog-warning" \
	string:"brouter handler failed" string:"status $status — see handler.log" \
	int32:5000 >/dev/null 2>&1 || true
exit "$status"
