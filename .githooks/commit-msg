#!/bin/sh
# Enforce conventional commits referencing a task ID (board rule:
# "a conventional commit referencing its ID"). Merge and revert subjects
# generated by git are exempt.
set -u

msgfile=$1
first=$(head -n 1 "$msgfile")

case "$first" in
"Merge "* | "Revert "*)
	exit 0
	;;
esac

reject() {
	echo "commit-msg: rejected: $1" >&2
	echo "subject: $first" >&2
	echo "expected: <type>(<scope>)?: TASK-XXXX <summary>" >&2
	echo "types: feat fix docs style refactor perf test chore build ci revert plans" >&2
	echo "example: feat(gate): TASK-0004 add versioned hooks" >&2
	exit 1
}

pattern='^(feat|fix|docs|style|refactor|perf|test|chore|build|ci|revert|plans)(\([^)]+\))?(!)?: .+'
printf '%s\n' "$first" | grep -Eq "$pattern" || reject "subject is not a conventional commit"

printf '%s\n' "$first" | grep -Eq 'TASK-[0-9]{4}' || reject "subject is missing a task reference (TASK-XXXX)"

exit 0
